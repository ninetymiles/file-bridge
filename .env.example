IMAGE_TAG=file-bridge:latest

CLIENT_ID=dingtalk_client_id
CLIENT_SECRET=dingtalk_client_secret

OUTPUT_DIR=output

# Set to true/1 to replace substring command matching with the embedding-based
# semantic matcher. First startup with it enabled must fetch the model from
# HuggingFace (honors HF_TOKEN / HF_HUB_OFFLINE); subsequent runs use the cache.
SEMANTIC_COMMAND_ENABLED=false

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
